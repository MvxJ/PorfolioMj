---
/* AboutSection.astro — photo (placeholder or CMS photo), bio, 3 stats. */
import type { Locale } from '../../i18n';
import { useT, localize } from '../../i18n';
import { getAbout, getAppearance, getProjects, getTech } from '../../lib/content';
import BaseSection from '../BaseSection.astro';
import Icon from '../primitives/Icon.astro';
import CountUp from '../islands/CountUp.tsx';
import { marked } from 'marked';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const about = await getAbout();
const appearance = await getAppearance();

// bio is authored in the CMS WYSIWYG (markdown) — render to HTML at build time.
const bioMd = localize(about?.bio, locale) ?? '';
const bioHtml = bioMd ? (marked.parse(bioMd, { async: false }) as string) : '';
const photo = about?.photo;
const countUp = appearance.animations && appearance.animStyle !== 'subtle';

// Stats flagged `projects`/`tech` are counted live from their collections;
// `manual` keeps the CMS-entered value. Suffix a "+" so live counts read as "6+".
const [projectCount, techCount] = await Promise.all([
  getProjects().then((p) => p.length),
  getTech().then((tch) => tch.length),
]);
const stats = (about?.stats ?? []).map((s) => {
  if (s.source === 'projects') return { ...s, value: `${projectCount}+` };
  if (s.source === 'tech') return { ...s, value: `${techCount}+` };
  return s;
});
---
<BaseSection id="about" pad="xl" labelledby="about-title">
  <div class="section-head">
    <p class="eyebrow aos">{t('sections.aboutEyebrow')}</p>
    <h2 class="section-title aos" id="about-title">{t('sections.aboutTitle')}</h2>
  </div>

  <div class="about-grid">
    <div class="about-media aos">
      <div class="about-photo">
        {photo ? (
          <img src={photo} alt={t('sections.aboutEyebrow')} loading="lazy" />
        ) : (
          <Icon name="person" size="45%" class="placeholder" />
        )}
      </div>

      <div class="stats">
        {stats.map((s) => (
          <div class="stat-card">
            <div class="stat-value">
              {countUp ? <CountUp client:visible value={s.value} /> : s.value}
            </div>
            <div class="stat-label">{localize(s.label, locale)}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="about-text aos">
      {bioHtml && <div class="about-bio" set:html={bioHtml} />}
    </div>
  </div>
</BaseSection>
